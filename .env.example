# --- Veritabanı ---
# Üretim için PostgreSQL önerilir (veri güvenliği + kolay yedek: pg_dump):
DATABASE_URL=postgresql+psycopg2://envanter:envanter@localhost:5432/envanter

# MySQL / MariaDB (aaPanel'in yönettiği veritabanını kullanmak istersen).
# charset=utf8mb4 ZORUNLU — Türkçe karakterler için:
# DATABASE_URL=mysql+pymysql://envanter:PAROLA@localhost:3306/envanter?charset=utf8mb4

# Geliştirme için hızlı başlangıç (dosya tabanlı, kurulum gerektirmez):
# DATABASE_URL=sqlite:///./envanter.db

# --- Kurum bilgileri (zimmet formu başlığında ve taahhüt metninde görünür) ---
ORG_NAME=Kurum Adı

# --- Yüklenen dosyalar (cihaz görselleri, imzalı zimmet formları) ---
# Veritabanında değil diskte tutulur. Yedeklerken bu klasörü de al!
# Göreli yol proje dizinine göredir.
UPLOAD_DIR=yuklemeler
MAX_UPLOAD_MB=20

# --- Yayın yolu ---
# Alt klasörde yayınlanıyorsa (örn. https://ernsaha.com.tr/envanter/) burayı doldur.
# Kök dizinde çalışıyorsa boş bırak.
ROOT_PATH=/envanter

# --- Kimlik doğrulama (JWT) ---
# ÜRETİMDE mutlaka değiştir: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# İlk admin kullanıcı (scripts/create_admin.py için)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Claude / Anthropic (doğal dil arama için) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Snipe-IT'ten veri taşıma (içe aktarım scripti için) ---
SNIPEIT_URL=https://snipe.ornek.com
SNIPEIT_TOKEN=
