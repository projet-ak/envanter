# --- Veritabanı ---
# Üretim için PostgreSQL önerilir (veri güvenliği + kolay yedek: pg_dump):
DATABASE_URL=postgresql+psycopg2://envanter:envanter@localhost:5432/envanter
# Geliştirme için hızlı başlangıç (dosya tabanlı, kurulum gerektirmez):
# DATABASE_URL=sqlite:///./envanter.db

# --- Kimlik doğrulama (JWT) ---
# ÜRETİMDE mutlaka değiştir: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# İlk admin kullanıcı (scripts/create_admin.py için)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Claude / Anthropic (doğal dil arama için) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Snipe-IT'ten veri taşıma (içe aktarım scripti için) ---
SNIPEIT_URL=https://snipe.ornek.com
SNIPEIT_TOKEN=
