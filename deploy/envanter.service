# Envanter API — systemd servis dosyası
#
# Kurulum:
#   sudo cp deploy/envanter.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now envanter
#
# Loglar:  sudo journalctl -u envanter -f

[Unit]
Description=Envanter API (FastAPI/Uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/ernsaha.com.tr/envanet

# Ortam değişkenleri .env dosyasından okunur
EnvironmentFile=/www/wwwroot/ernsaha.com.tr/envanet/.env

# 4 çekirdek için 4 worker uygundur (2*çekirdek+1 yerine bellek dostu seçim)
ExecStart=/www/wwwroot/ernsaha.com.tr/envanet/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8901 \
    --workers 4 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1 \
    --root-path /envanet

Restart=always
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30

# Güvenlik sıkılaştırma
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
